              }
            },
            "description": "Not found",
            "headers": {
              "X-Request-ID": {
                "description": "Echoed from the request, or generated (UUIDv4) if absent/invalid",
                "schema": {
                  "format": "uuid",
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Get Complaint",
        "tags": [
          "complaints"
        ]
      }
    },
    "/api/complaints/{id}/status": {
      "patch": {
        "operationId": "update_complaint_status",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplaintOut"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-Request-ID": {
                "description": "Echoed from the request, or generated (UUIDv4) if absent/invalid",
                "schema": {
                  "format": "uuid",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failed \u2014 field-level errors in `error.fields`",
            "headers": {
              "X-Request-ID": {
                "description": "Echoed from the request, or generated (UUIDv4) if absent/invalid",
                "schema": {
                  "format": "uuid",
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not found",
            "headers": {
              "X-Request-ID": {
                "description": "Echoed from the request, or generated (UUIDv4) if absent/invalid",
                "schema": {
                  "format": "uuid",
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid status transition \u2014 `error.details` names `from` and `to`",
            "headers": {
              "X-Request-ID": {
                "description": "Echoed from the request, or generated (UUIDv4) if absent/invalid",
                "schema": {
                  "format": "uuid",
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Update Complaint Status",
        "tags": [
          "complaints"
        ]
      }
    },
    "/api/meta/providers": {
