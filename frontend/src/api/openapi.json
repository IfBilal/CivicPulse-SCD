            "description": "Successful Response",
            "headers": {
              "X-Request-ID": {
                "description": "Echoed from the request, or generated (UUIDv4) if absent/invalid",
                "schema": {
                  "format": "uuid",
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
